# Chave da OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Modelo padrão para coding (recomendado: Qwen 2.5 Coder 32B ou DeepSeek V3)
KCODE_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Modelo mais forte / raciocínio pesado (/model strong) (ex: DeepSeek R1, Llama 3.3 70B)
KCODE_MODEL_STRONG=deepseek/deepseek-r1

# Modelo gratuito ou fallback (/model free)
KCODE_MODEL_FREE=deepseek/deepseek-chat:free

# Hosts SSH permitidos (separados por vírgula)
SSH_ALLOWED_HOSTS=vps1.exemplo.com,vps2.exemplo.com

# Usuário SSH padrão
SSH_DEFAULT_USER=deploy

# Caminho da chave privada SSH
SSH_KEY_PATH=~/.ssh/id_rsa

# Sites de deploy conhecidos (JSON)
# {"nome": {"host": "vps1.exemplo.com", "path": "/var/www/nome", "cmd": "git pull && pm2 restart nome"}}
DEPLOY_SITES={}
